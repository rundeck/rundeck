# framework.properties -
#

# ----------------------------------------------------------------
# Server connection information
# ----------------------------------------------------------------

framework.server.name = @framework.server.name@
framework.server.hostname = @framework.server.hostname@
framework.server.port = @framework.server.port@
framework.server.url = @framework.rundeck.url@

# ----------------------------------------------------------------
# Installation locations
# ----------------------------------------------------------------

rdeck.base=@rdeck.base@

framework.projects.dir=@rdeck.base@/projects
framework.etc.dir=@framework.etc.dir@
framework.var.dir=@framework.var.dir@
framework.tmp.dir=@framework.var.dir@/tmp
framework.logs.dir=@framework.var.dir@/logs
framework.libext.dir=@rdeck.base@/libext

# ----------------------------------------------------------------
# SSH defaults for node executor and file copier
# ----------------------------------------------------------------

framework.ssh.keypath = @framework.ssh.keypath@
framework.ssh.user = @framework.ssh.user@

# ssh connection timeout after a specified number of milliseconds.
# "0" value means wait forever.
framework.ssh.timeout = 0

# ----------------------------------------------------------------
# Auto generated server UUID: @rundeck.server.uuid@
# ----------------------------------------------------------------
rundeck.server.uuid = @rundeck.server.uuid@

# ----------------------------------------------------------------
# System-wide global variables.
# ----------------------------------------------------------------

# Expands to ${globals.var1}
#framework.globals.var1 = value1

# Expands to ${globals.var2}
#framework.globals.var2 = value2

# ----------------------------------------------------------------
# Git SCM remote URL controls. Both are unset by default so existing
# Git import/export configuration keeps working.
# The same keys in System Configuration apply without a restart and override
# a value set here. A blank System Configuration value leaves this file in effect.
#
# Comma-separated schemes. ssh includes ssh:// and git@host:path.
# file includes file:// and local paths.
# rundeck.scm.git.allowedSchemes=https,http,ssh
#
# Reject loopback, link-local, and private addresses, including HTTP redirects.
# rundeck.scm.git.blockInternalAddresses=false

