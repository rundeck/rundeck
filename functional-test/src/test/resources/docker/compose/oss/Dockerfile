ARG IMAGE
# In CI the "tools" stage is prebuilt once per pipeline and passed here (TEST_OSS_TOOLS_IMAGE);
# otherwise the build falls back to the "tools" stage below.
ARG TOOLS_IMAGE=tools

FROM ${IMAGE} AS tools
USER root

RUN apt-get update && \
    apt-get install -y netcat && \
    apt-get -y install sshpass

RUN apt-get install -y netcat

# install ansible
RUN apt-get update && \
    apt-get -y install python3-pip && \
    apt-get -y install iputils-ping && \
    pip3 install --upgrade pip

RUN pip3 install ansible==9.6.1

FROM ${TOOLS_IMAGE}
USER root

# The ssh keys are generated by the tests on every run, so they cannot be part of the prebuilt tools image.
COPY --chown=rundeck:root keys /home/rundeck/privatekeys
RUN chown -R rundeck /home/rundeck/privatekeys
RUN chmod 770 /home/rundeck/privatekeys

USER rundeck
