    "deep-object-diff": "1.1.9",
    "dompurify": "3.4.14",
    "fuse.js": "6.6.2",
    "graphlib": "2.1.8",
    "jointjs": "3.7.7",
    "mitt": "3.0.1",
    "mobx": "5.15.7",
    "mobx-utils": "5.6.2",
    "moment": "2.30.1",
    "perfect-scrollbar": "1.5.6",
